# Copy to .env (never commit .env)
# Copernicus Data Space account (free): https://dataspace.copernicus.eu
# Used by the local Sentinel-1 GRD fallback. openEO has its own browser login (cached after first use).
CDSE_USERNAME=
CDSE_PASSWORD=

# Sentinel Hub OAuth client (fast radar/optical processing on Copernicus Data Space; also logs openEO in
# without a browser). Create at https://shapps.dataspace.copernicus.eu/dashboard -> User settings -> OAuth clients
SH_CLIENT_ID=
SH_CLIENT_SECRET=

# Optional: non-interactive openEO login (client credentials), e.g. on a server
# OPENEO_AUTH_METHOD=client_credentials
# OPENEO_AUTH_CLIENT_ID=
# OPENEO_AUTH_CLIENT_SECRET=
# OPENEO_AUTH_PROVIDER_ID=CDSE

# ohsome API v2 key (free): https://account.heigit.org/signup
# Without it FloodSight falls back to the keyless ohsome v1 API (retiring 30 Nov 2026).
OHSOME_API_KEY=

# Public deployment only (e.g. Hugging Face Space shared with judges): see deploy/README.md
# FLOODSIGHT_PUBLIC=1
# FLOODSIGHT_ACCESS_CODE=choose-a-long-code
# FLOODSIGHT_MAX_KM2=1600
# FLOODSIGHT_MAX_RUNS_DAY=20
# FLOODSIGHT_PU_DAY=2500
